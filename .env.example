# Copy to .env and fill in values. .env is gitignored.
#
# bardo-supervisor.sh and mori.sh source .env automatically at startup.

# ── LLM Provider Keys ──────────────────────────────────────────────
# Required: at least one provider key must be set.
ANTHROPIC_API_KEY=            # sk-ant-... (required for Claude models)
OPENAI_API_KEY=               # sk-... (optional, for GPT/Codex models)

# ── Bardo Gateway ──────────────────────────────────────────────────
# The gateway generates a random key on startup if not set.
BARDO_GATEWAY_API_KEY=        # any string (shared secret for gateway auth)
BARDO_GATEWAY_URL=http://127.0.0.1:4000  # gateway address

# ── RPC / Mirage ───────────────────────────────────────────────────
# Leave unset to auto-start a local anvil instance (requires foundry in PATH).
MIRAGE_RPC_URL=               # e.g. https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
MIRAGE_WS_URL=                # e.g. wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
MIRAGE_FORK_BLOCK=            # Pin to a block for determinism (e.g. 21000000)

# Rate limiting for upstream RPC
MIRAGE_UPSTREAM_RPS=100
MIRAGE_UPSTREAM_BURST=200

# ── Timeouts ───────────────────────────────────────────────────────
CODEX_TIMEOUT=3600            # Max seconds per codex session
CARGO_TEST_TIMEOUT=900        # Max seconds for the test gate

# ── Anvil (auto-started when MIRAGE_RPC_URL is unset) ─────────────
ANVIL_PORT=8545
ANVIL_BLOCK_TIME=2
ANVIL_CHAIN_ID=31337
