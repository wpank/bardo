# Copy to .env and fill in values. .env is gitignored.
#
# run-plans.sh sources .env automatically at startup.

# RPC nodes for mirage-rs and integration tests.
# Leave unset to auto-start a local anvil instance (requires foundry in PATH).
MIRAGE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/L8lRc4P8NvKni000Tv1v7           # e.g. https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
MIRAGE_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/L8lRc4P8NvKni000Tv1v7 # e.g. wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
MIRAGE_FORK_BLOCK=        # Pin to a block for determinism (e.g. 21000000)

# Rate limiting for upstream RPC
MIRAGE_UPSTREAM_RPS=100
MIRAGE_UPSTREAM_BURST=200

# Timeouts
CODEX_TIMEOUT=3600        # Max seconds per codex session
CARGO_TEST_TIMEOUT=900    # Max seconds for the test gate

# Anvil (auto-started when MIRAGE_RPC_URL is unset and anvil is on PATH)
ANVIL_PORT=8545
ANVIL_BLOCK_TIME=2        # Mine a block every 2s (deterministic)
ANVIL_CHAIN_ID=31337
